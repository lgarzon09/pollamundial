# Credenciales de Supabase — cópialo a .env.local y reemplaza los valores.
# Las encuentras en: Supabase Dashboard → tu proyecto → Settings → API

# URL del proyecto (ej. https://xxxxxxxx.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# Clave pública (anon / publishable key)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Opcional: clave de servicio (solo para tareas server-side con privilegios).
# NO la expongas en el cliente.
# SUPABASE_SECRET_KEY=
